# =============================================================================
# supacommerce — environment variables
# Rename this file to .env and fill in your values.
# =============================================================================

# ─── Base ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Email (Resend) — used by order-confirmed and admin-send-invite
RESEND_API_KEY="re_..."
RESEND_FROM="Your Store <orders@yourdomain.com>"
EMAIL_FROM="orders@yourdomain.com"

# URL of your admin dashboard — used by admin-send-invite to build invite links
DASHBOARD_URL="https://your-dashboard-url.com"

# ─── Dashboard ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="your_supabase_project_url"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Admin seed script — never expose service role key client-side
VITE_SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
VITE_ADMIN_EMAIL="admin@yourdomain.com"
VITE_ADMIN_PASSWORD="your_secure_password"
VITE_ADMIN_FIRST_NAME="First"
VITE_ADMIN_LAST_NAME="Last"

# ─── Storefront ───────────────────────────────────────────────────────────────
# VITE_SUPABASE_URL="your_supabase_project_url"    # same as dashboard
# VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"  # same as dashboard