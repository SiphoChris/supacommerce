# =============================================================================
# supacommerce — environment variables
# Rename this file to .env and fill in your values.
# =============================================================================


# ─── Base ─────────────────────────────────────────────────────────────────────
# Required by Drizzle ORM for migrations.
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Email (Resend) — used by order-confirmed and admin-send-invite.
# Set these as Supabase edge function secrets:
#   supabase secrets set RESEND_API_KEY=re_...
RESEND_API_KEY="re_..."
RESEND_FROM="Your Store <orders@yourdomain.com>"
EMAIL_FROM="orders@yourdomain.com"

# URL of your admin dashboard — used by admin-send-invite to build invite links.
# supabase secrets set DASHBOARD_URL=https://your-dashboard.com
DASHBOARD_URL="https://your-dashboard-url.com"

# Set to "development" to allow payment-webhook to run without signature verification.
# Never use "development" in production — implement signature verification first.
# supabase secrets set ENVIRONMENT=development
ENVIRONMENT="development"

# Payment provider — uncomment when you wire in your provider in:
#   supabase/functions/cart-checkout/index.ts
#   supabase/functions/payment-webhook/index.ts
# supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."


# ─── Dashboard ────────────────────────────────────────────────────────────────
# Used by the admin dashboard app and the seed:admin script.
VITE_SUPABASE_URL="your_supabase_project_url"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Service role key — used only by the seed:admin script.
# Never expose this client-side.
VITE_SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
VITE_ADMIN_EMAIL="admin@yourdomain.com"
VITE_ADMIN_PASSWORD="your_secure_password"
VITE_ADMIN_FIRST_NAME="First"
VITE_ADMIN_LAST_NAME="Last"


# ─── Storefront ───────────────────────────────────────────────────────────────
# Used by your storefront app. Same values as dashboard above.
# VITE_SUPABASE_URL="your_supabase_project_url"
# VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"